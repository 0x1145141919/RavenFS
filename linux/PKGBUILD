# Maintainer: PS <bydwxt@163.com>
# ravenfs-dkms —— RavenFS（实验性）内核模块。
#   内核更新：DKMS alpm hook 自动为每个已装内核重编（需对应 *-headers）。
#   initramfs：自带 /etc/mkinitcpio.conf.d/ravenfs.conf → 自动入镜像。
# v0.2.0（2026-10-06）：盘面契约 v2.0 大迁移（KO 追平上帝类两跳：v1.2 → v1.3 → v2.0）。
#   第一跳 v1.3：每目录「名字数据面」（映射树 + 字节粒度 fr 空闲区间树）取代 10 档名字堆；
#     ddentry 长名改逻辑偏移 full_char_remain_offset；extent 机械 kind 参数化。
#   第二跳 v2.0：SB 256-bit magic + 无 root_inode（root idx 硬编码 0，st_ino=1）；
#     全局弹性 inode 数据面（8K 片 direct/映射树 + 扁 fr 快照）取代固定 inode 数组 + inode 位图；
#     InodeSession 走「翻译→物理 8K 片→mdata」；分配器 inode 组换数据面（块组不变）。
#   ⚠️ 与 v1.x 盘不兼容 → reformat，无迁移工具。审计：audit_v13/v20 均 bad_total=0。
#   ⚠️ 包内容修正：随盘面头引入 `include/ravenfs/rc.hpp`（disk_struct_v*.h #include），
#      本次一并安装 include/ravenfs/，否则 DKMS 构建缺头。
# v0.1.3（2026-10-04）：运行时分配器 v2（树版）cutover —— 位图模块整体退役（`rfs_bm` 类删除），
#   改多分片主从红黑树（`rfs_allocator`：router/slice/rbtree/run_list + allocator_adapter）。
#   顺带：D-10 `i_ino = inode_idx + 1` 契约（访问器收敛 91 处 `->i_ino`）；D-11 新增 procfs 公开出口
#   `/proc/fs/ravenfs/<s_id>/stats`（人人可读，事实 ABI）；计数器 F 组 `bm_`(18) 退役 → `al_`(36) 注入式。
#   D-7/D-8 由分配器 v2 结构性消解（best-fit 无位置游标 / 独立几何查询取代共用前移游标）。
#   详见 Docs/linux/ravenfs-linux-ko-defects.md。
pkgname=ravenfs-dkms
pkgver=0.2.0
pkgrel=1
pkgdesc="RavenFS (experimental) kernel module, built via DKMS"
arch=('x86_64')
url="https://github.com/openclaw/openclaw"
license=('GPL-2.0-only')
depends=('dkms')
options=('!strip')
# 个人包：直接从本地源树拷贝（可用 RVN_SRC 覆盖）；不走 tarball/网络。
_srcroot="${RVN_SRC:-/home/PS/PS_git/OS_pj_uefi/ravenfs}"
source=('dkms.conf' 'mkinitcpio-ravenfs-hook')
sha256sums=('SKIP' 'SKIP')

package() {
  local dst="$pkgdir/usr/src/ravenfs-${pkgver}"
  # 头文件集中化（2026-09-30）：ko 自有头在 include/linux/，盘面头/魔数在 include/ 根。
  # 目录布局必须与 Makefile 的 -I$(src)/../include -I$(src)/../include/linux 对应。
  install -d "$dst/linux" "$dst/include" "$dst/include/linux" "$dst/include/ravenfs"
  install -m644 "$_srcroot"/linux/*.c  "$dst/linux/"
  install -m644 "$_srcroot"/linux/Makefile "$dst/linux/"
  rm -f "$dst/linux/"*.mod.c "$dst/linux/"*.o "$dst/linux/"*.ko "$dst/linux/".*.cmd
  install -m644 "$_srcroot"/include/linux/*.h "$dst/include/linux/"
  install -m644 "$_srcroot"/include/*.h "$dst/include/"
  # include/ravenfs/：盘面头 disk_struct_v*.h 反向 #include "ravenfs/rc.hpp"
  # （结果码/哨兵轻量头）；不装则 DKMS 构建缺头。随包快照一并安装。
  install -m644 "$_srcroot"/include/ravenfs/*.hpp "$dst/include/ravenfs/" 2>/dev/null || true
  install -m644 "$srcdir/dkms.conf" "$dst/dkms.conf"
  sed -i "s/@PKGVER@/${pkgver}/" "$dst/dkms.conf"
  install -Dm755 "$srcdir/mkinitcpio-ravenfs-hook" "$pkgdir/usr/lib/initcpio/install/ravenfs"
}
