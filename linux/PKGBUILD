# Maintainer: PS <bydwxt@163.com>
# ravenfs-dkms —— RavenFS（实验性）内核模块。
#   内核更新：DKMS alpm hook 自动为每个已装内核重编（需对应 *-headers）。
#   initramfs：自带 /etc/mkinitcpio.conf.d/ravenfs.conf → 自动入镜像。
#
# pkgver=0.2.4（2026-10-23）—— 本版本内容：
#   · D-4：O_DIRECT（iomap DIO）落地。->open 置 FMODE_CAN_ODIRECT；读写在
#     read_iter/write_iter 自路由 iomap_dio_rw（不走 a_ops->direct_IO）；
#     写 4K 对齐 + FORCE_WAIT + -ENOTBLK 回退；inline 文件 DIO 读走
#     iomap_dio_inline_iter。详见 Docs/linux/ravenfs-linux-ko-defects.md D-4。
#   · mdata 空闲强淘汰：TTL work 在静置 ravenfs_idle_squeeze_seconds（默认 30s）
#     后触发 SQUEEZE_LOWLOAD，回收冷行与空表；与用户 ioctl 共用 squeeze_lock；
#     /proc stats 新增 md_idle_squeeze / md_idle_ms。
#
# ⚠️ 盘面 v2.0：与 v1.x 不兼容 → 需 reformat，无迁移工具。
#
# pkgrel=2（2026-10-27）—— 新增公共盘面契约头安装：
#   /usr/include/ravenfs/{disk_struct_v2.0.h, magics.h, rc.hpp}
#   供 init.elf / panic.elf / 宿主工具以 <ravenfs/...> 消费；
#   /usr/src/ravenfs-<pkgver>/include 的 DKMS 内部快照保持不变（路径随版本变，
#   不能作为消费方的稳定 -I）。
pkgname=ravenfs-dkms
pkgver=0.2.4

pkgrel=2
pkgdesc="RavenFS (experimental) kernel module, built via DKMS"
arch=('x86_64')
url="https://github.com/openclaw/openclaw"
license=('GPL-2.0-only')
depends=('dkms')
makedepends=('gcc')
options=('!strip')
# 个人包：直接从本地源树拷贝（可用 RVN_SRC 覆盖）；不走 tarball/网络。
_srcroot="${RVN_SRC:-/home/PS/PS_git/OS_pj_uefi/ravenfs}"
source=('dkms.conf' 'mkinitcpio-ravenfs-hook')
sha256sums=('SKIP' 'SKIP')

package() {
  local dst="$pkgdir/usr/src/ravenfs-${pkgver}"
  # 头文件集中化（2026-09-30）：ko 自有头在 include/linux/，盘面头/魔数在 include/ 根。
  # 目录布局必须与 Makefile 的 -I$(src)/../include -I$(src)/../include/linux 对应。
  install -d "$dst/linux" "$dst/include" "$dst/include/linux" "$dst/include/ravenfs"
  install -m644 "$_srcroot"/linux/*.c  "$dst/linux/"
  install -m644 "$_srcroot"/linux/Makefile "$dst/linux/"
  rm -f "$dst/linux/"*.mod.c "$dst/linux/"*.o "$dst/linux/"*.ko "$dst/linux/".*.cmd
  install -m644 "$_srcroot"/include/linux/*.h "$dst/include/linux/"
  install -m644 "$_srcroot"/include/*.h "$dst/include/"
  # include/ravenfs/：盘面头 disk_struct_v*.h 反向 #include "ravenfs/rc.hpp"
  # （结果码/哨兵轻量头）；不装则 DKMS 构建缺头。随包快照一并安装。
  install -m644 "$_srcroot"/include/ravenfs/*.hpp "$dst/include/ravenfs/" 2>/dev/null || true

  # ── 公共盘面契约头（2026-10-27）──
  # DKMS 快照在 /usr/src/ravenfs-<pkgver>/include：路径随包版本变化，只服务本包构建，
  # 不能作为外部消费方的稳定 -I。这里另装一份到 /usr/include/ravenfs/：
  #     #include <ravenfs/disk_struct_v2.0.h>
  #     #include <ravenfs/magics.h>
  #     #include <ravenfs/rc.hpp>
  # 只装“盘结构真值三件套”；参考实现的 .hpp 属于原型，不进公共头。
  install -d "$pkgdir/usr/include/ravenfs"
  install -m644 "$_srcroot/include/disk_struct_v2.0.h" "$pkgdir/usr/include/ravenfs/"
  install -m644 "$_srcroot/include/magics.h"           "$pkgdir/usr/include/ravenfs/"
  install -m644 "$_srcroot/include/ravenfs/rc.hpp"     "$pkgdir/usr/include/ravenfs/"

  install -m644 "$srcdir/dkms.conf" "$dst/dkms.conf"
  sed -i "s/@PKGVER@/${pkgver}/" "$dst/dkms.conf"
  install -Dm755 "$srcdir/mkinitcpio-ravenfs-hook" "$pkgdir/usr/lib/initcpio/install/ravenfs"

  # 用户态 mdata 缓存强淘汰工具：/usr/bin/rfs_cachectl
  # 编译参数与 tools/Makefile 一致；usrmerge 下 /usr/bin 即 /bin。
  install -d "$pkgdir/usr/bin"
  gcc -std=gnu11 -O2 -Wall -Wextra -Werror \
      -I "$_srcroot/include/linux" \
      "$_srcroot/tools/rfs_cachectl.c" \
      -o "$pkgdir/usr/bin/rfs_cachectl"
}
