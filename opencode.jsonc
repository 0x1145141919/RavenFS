{
  "$schema": "https://opencode.ai/config.json",

  // 黑名单制度：默认全放行，只有黑名单（sudo/rm/rmdir）封禁、git 树操纵要审核
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },

    // 黑牌：sudo 出现即封；rm/rmdir 黄牌（ask，需审核）
    { "action": "shell", "resource": "sudo *",    "effect": "deny" },
    { "action": "shell", "resource": "rm *",      "effect": "ask" },
    { "action": "shell", "resource": "rmdir *",   "effect": "ask" },
    { "action": "shell", "resource": "*/rm *",    "effect": "ask" },
    { "action": "shell", "resource": "*/rmdir *", "effect": "ask" },

    // 黄牌：git 树操纵（要审核）
    { "action": "shell", "resource": "git add *",            "effect": "ask" },
    { "action": "shell", "resource": "git am *",             "effect": "ask" },
    { "action": "shell", "resource": "git apply *",          "effect": "ask" },
    { "action": "shell", "resource": "git branch -d *",       "effect": "ask" },
    { "action": "shell", "resource": "git branch -D *",       "effect": "ask" },
    { "action": "shell", "resource": "git branch -m *",       "effect": "ask" },
    { "action": "shell", "resource": "git branch -M *",       "effect": "ask" },
    { "action": "shell", "resource": "git checkout *",        "effect": "ask" },
    { "action": "shell", "resource": "git cherry-pick *",     "effect": "ask" },
    { "action": "shell", "resource": "git clean *",          "effect": "ask" },
    { "action": "shell", "resource": "git commit *",         "effect": "ask" },
    { "action": "shell", "resource": "git filter-branch *",   "effect": "ask" },
    { "action": "shell", "resource": "git filter-repo *",     "effect": "ask" },
    { "action": "shell", "resource": "git gc *",             "effect": "ask" },
    { "action": "shell", "resource": "git merge *",          "effect": "ask" },
    { "action": "shell", "resource": "git mv *",             "effect": "ask" },
    { "action": "shell", "resource": "git pull *",           "effect": "ask" },
    { "action": "shell", "resource": "git prune *",          "effect": "ask" },
    { "action": "shell", "resource": "git rebase *",         "effect": "ask" },
    { "action": "shell", "resource": "git replace *",        "effect": "ask" },
    { "action": "shell", "resource": "git reset *",          "effect": "ask" },
    { "action": "shell", "resource": "git restore *",        "effect": "ask" },
    { "action": "shell", "resource": "git revert *",         "effect": "ask" },
    { "action": "shell", "resource": "git rm *",             "effect": "ask" },
    { "action": "shell", "resource": "git sparse-checkout *","effect": "ask" },
    { "action": "shell", "resource": "git stash *",          "effect": "ask" },
    { "action": "shell", "resource": "git submodule *",      "effect": "ask" },
    { "action": "shell", "resource": "git switch *",         "effect": "ask" },
    { "action": "shell", "resource": "git tag -a *",         "effect": "ask" },
    { "action": "shell", "resource": "git tag -d *",         "effect": "ask" },
    { "action": "shell", "resource": "git tag -f *",         "effect": "ask" },
    { "action": "shell", "resource": "git tag -s *",         "effect": "ask" },
    { "action": "shell", "resource": "git update-index *",   "effect": "ask" },
    { "action": "shell", "resource": "git worktree *",       "effect": "ask" }
  ]
}
